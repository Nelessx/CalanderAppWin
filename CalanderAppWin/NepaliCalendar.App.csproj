<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>NepaliCalendar.App</AssemblyName>
    <Product>Nepali Calendar</Product>
    <Company>Nepali Calendar</Company>
    <Authors>Nelessx</Authors>
    <Description>A Nepali (Bikram Sambat) calendar for Windows with desktop widgets, events, and date conversion.</Description>
    <Copyright>Copyright © 2025 Nepali Calendar</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- WinForms is used only for the tray icon (TrayIconService). Drop its implicit
       global usings so System.Drawing/System.Windows.Forms names (Brush, Point,
       MouseEventArgs, ...) don't collide with WPF; that one file imports them itself. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

	<ItemGroup>
		<!-- Copy the raw editable BS calendar file into the output folder -->
		<None Update="Data\bs-calendar-raw.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- Copy the generated JSON calendar file into the output folder -->
		<None Update="Data\bs-calendar-data.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
