<Window
    x:Class="NepaliCalendar.App.Views.AddEventWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Event"
    Width="460"
    Background="{DynamicResource WindowBrush}"
    FocusManager.FocusedElement="{Binding ElementName=TitleTextBox}"
    FontFamily="Segoe UI"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Padding="24">
        <StackPanel>

            <TextBlock
                x:Name="HeaderText"
                Margin="0,0,0,4"
                FontSize="22"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="Add Event" />

            <TextBlock
                x:Name="SubHeaderText"
                Margin="0,0,0,20"
                FontSize="13"
                Foreground="{DynamicResource TextMutedBrush}"
                Text="Create a new event on your calendar." />

            <!--  TITLE  -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Title *" />
            <TextBox x:Name="TitleTextBox" MaxLength="120" />

            <!--  NEPALI TITLE  -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Nepali Title (optional)" />
            <TextBox x:Name="NepaliTitleTextBox" MaxLength="120" />

            <!--  BS DATE  -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Date (BS)" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="YearComboBox"
                    Grid.Column="0"
                    SelectionChanged="DateSelector_Changed" />

                <ComboBox
                    x:Name="MonthComboBox"
                    Grid.Column="2"
                    SelectionChanged="DateSelector_Changed" />

                <ComboBox x:Name="DayComboBox" Grid.Column="4" />
            </Grid>

            <!--  ALL DAY + TIME  -->
            <CheckBox
                x:Name="AllDayCheckBox"
                Margin="0,0,0,12"
                Checked="AllDayCheckBox_Changed"
                Content="All day"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Unchecked="AllDayCheckBox_Changed" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Time (optional, e.g. 09:30 AM)" />
            <TextBox x:Name="TimeTextBox" MaxLength="40" />

            <!--  REMINDER  -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Reminder" />
            <ComboBox x:Name="ReminderComboBox" Margin="0,0,0,14" />

            <!--  TYPE  -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Type (optional, e.g. Meeting)" />
            <TextBox x:Name="TypeTextBox" MaxLength="60" />

            <!--  BADGE  -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Badge (optional, e.g. Work)" />
            <TextBox x:Name="BadgeTextBox" MaxLength="40" />

            <!--  ACTIONS  -->
            <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="0,0,10,0"
                    Click="Cancel_Click"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />

                <Button
                    x:Name="SaveButton"
                    Click="Save_Click"
                    Content="Save Event"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
