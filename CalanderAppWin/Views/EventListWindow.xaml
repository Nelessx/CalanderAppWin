<Window
    x:Class="NepaliCalendar.App.Views.EventListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Events"
    Width="600"
    Height="640"
    MinWidth="480"
    MinHeight="420"
    Background="#F6F9FF"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6D4AFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5B3EE6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E34C9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Foreground" Value="#4A5670" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#D9E2F0"
                            BorderThickness="1"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4A5670" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="12,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#D9E2F0"
                            BorderThickness="1"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowDangerButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="12,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#F3C6C6"
                            BorderThickness="1"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FDECEC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#0B1B45"
                    Text="Events" />

                <Border
                    Margin="10,0,0,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="#EAF3FF"
                    CornerRadius="8">
                    <TextBlock
                        x:Name="EventCountText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#1E40AF"
                        Text="0" />
                </Border>
            </StackPanel>

            <Button
                HorizontalAlignment="Right"
                Click="AddEvent_Click"
                Content="+ Add Event"
                Style="{StaticResource PrimaryButton}" />
        </Grid>

        <!--  LIST  -->
        <Border
            Grid.Row="1"
            Padding="6"
            Background="White"
            BorderBrush="#D9E2F0"
            BorderThickness="1"
            CornerRadius="14">

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="EventsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="6"
                                    Padding="12"
                                    Background="#FBFCFE"
                                    BorderBrush="#E1E7F0"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse
                                            Width="9"
                                            Height="9"
                                            Margin="0,6,10,0"
                                            VerticalAlignment="Top"
                                            Fill="#7C5CFA" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#0B1B45"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="12"
                                                Foreground="#5B6680"
                                                Text="{Binding DateText}" />

                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="#5B6680"
                                                Text="{Binding TimeText}" />

                                            <Border
                                                Margin="0,6,0,0"
                                                Padding="7,3"
                                                HorizontalAlignment="Left"
                                                Background="#EEF0FF"
                                                CornerRadius="6"
                                                Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#4E34C9"
                                                    Text="{Binding BadgeText}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,8,0"
                                                Click="Edit_Click"
                                                Content="Edit"
                                                Style="{StaticResource RowButton}" />
                                            <Button
                                                Click="Delete_Click"
                                                Content="Delete"
                                                Style="{StaticResource RowDangerButton}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#94A3B8"
                    Text="No events yet. Click &quot;+ Add Event&quot; to create one."
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <!--  FOOTER  -->
        <Button
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Click="Close_Click"
            Content="Close"
            IsCancel="True"
            Style="{StaticResource SecondaryButton}" />
    </Grid>
</Window>
