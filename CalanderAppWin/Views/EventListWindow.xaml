<Window
    x:Class="NepaliCalendar.App.Views.EventListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Events"
    Width="600"
    Height="640"
    MinWidth="480"
    MinHeight="420"
    Background="{DynamicResource WindowBrush}"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="16,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="12,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowDangerButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="12,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="Events" />

                <Border
                    Margin="10,0,0,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource InfoSoftBrush}"
                    CornerRadius="8">
                    <TextBlock
                        x:Name="EventCountText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="0" />
                </Border>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Click="Import_Click"
                    Content="Import"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    Click="AddEvent_Click"
                    Content="+ Add Event"
                    Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <!--  SEARCH  -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBox
                x:Name="SearchBox"
                Height="34"
                Padding="8,0"
                VerticalContentAlignment="Center"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                FontSize="13"
                Foreground="{DynamicResource TextPrimaryBrush}"
                TextChanged="SearchBox_TextChanged" />
            <TextBlock
                x:Name="SearchHint"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource TextDisabledBrush}"
                IsHitTestVisible="False"
                Text="Search events by title, type, or badge…" />
        </Grid>

        <!--  LIST  -->
        <Border
            Grid.Row="2"
            Padding="6"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="EventsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="6"
                                    Padding="12"
                                    Background="{DynamicResource CardMutedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse
                                            Width="9"
                                            Height="9"
                                            Margin="0,6,10,0"
                                            VerticalAlignment="Top"
                                            Fill="{DynamicResource EventDotBrush}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding DateText}" />

                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding TimeText}" />

                                            <Border
                                                Margin="0,6,0,0"
                                                Padding="7,3"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="6"
                                                Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource AccentTextBrush}"
                                                    Text="{Binding BadgeText}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,8,0"
                                                Click="Edit_Click"
                                                Content="Edit"
                                                Style="{StaticResource RowButton}" />
                                            <Button
                                                Click="Delete_Click"
                                                Content="Delete"
                                                Style="{StaticResource RowDangerButton}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TextDisabledBrush}"
                    Text="No events yet. Click &quot;+ Add Event&quot; to create one."
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <!--  FOOTER  -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button
                x:Name="UndoButton"
                HorizontalAlignment="Left"
                Click="Undo_Click"
                Content="↶ Undo delete"
                IsEnabled="False"
                Style="{StaticResource SecondaryButton}" />

            <Button
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="Close"
                IsCancel="True"
                Style="{StaticResource SecondaryButton}" />
        </Grid>
    </Grid>
</Window>
