<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="WindowBrush" Color="#0F1420" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161C28" />
    <SolidColorBrush x:Key="CardBrush" Color="#1B2231" />
    <SolidColorBrush x:Key="CardMutedBrush" Color="#212A3B" />
    <SolidColorBrush x:Key="InputBrush" Color="#1B2231" />

    <!--  Borders / dividers  -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3548" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28313F" />
    <SolidColorBrush x:Key="DividerBrush" Color="#28313F" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EDF7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB4CA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C97AF" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#6F7B94" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#59637A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!--  Accent (purple)  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8B6EFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6E52F0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A594FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#272151" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#3A3372" />
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#262F40" />
    <SolidColorBrush x:Key="EventDotBrush" Color="#9E88FF" />

    <!--  Blue / info / today  -->
    <SolidColorBrush x:Key="InfoBrush" Color="#93B4FF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1C2A46" />
    <SolidColorBrush x:Key="TodayBrush" Color="#5FA8F5" />
    <SolidColorBrush x:Key="TodaySoftBrush" Color="#274468" />

    <!--  Green / success / holidays  -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessDotBrush" Color="#34D399" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#14311F" />
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#245139" />

    <!--  Red / danger / saturday  -->
    <SolidColorBrush x:Key="SaturdayBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1E1E" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#5A2E2E" />

    <!--  Context menus (right-click)  -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#1B2231" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#2B3548" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#262F40" />
    <SolidColorBrush x:Key="MenuItemPressedBrush" Color="#2F3A4E" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#E9EDF7" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#28313F" />
    <SolidColorBrush x:Key="MenuSubtleBrush" Color="#8C97AF" />
    <SolidColorBrush x:Key="MenuDisabledBrush" Color="#59637A" />

</ResourceDictionary>
