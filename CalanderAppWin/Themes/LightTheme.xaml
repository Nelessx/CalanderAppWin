<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F6F9FF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardMutedBrush" Color="#FBFCFE" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />

    <!--  Borders / dividers  -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D9E2F0" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E1E7F0" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E7EEF8" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0B1B45" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5670" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5B6680" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#7A8FC0" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!--  Accent (purple)  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6D4AFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B3EE6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4E34C9" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#6D4AFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFEAFF" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#DCD6FF" />
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#F1F5FD" />
    <SolidColorBrush x:Key="EventDotBrush" Color="#7C5CFA" />

    <!--  Blue / info / today  -->
    <SolidColorBrush x:Key="InfoBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#EAF3FF" />
    <SolidColorBrush x:Key="TodayBrush" Color="#1E90FF" />
    <SolidColorBrush x:Key="TodaySoftBrush" Color="#BFDDF8" />

    <!--  Green / success / holidays  -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessDotBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAFBF0" />
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#BFE8CE" />

    <!--  Red / danger / saturday  -->
    <SolidColorBrush x:Key="SaturdayBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F3C6C6" />

    <!--  Context menus (right-click)  -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F6F9FF" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#DCE7F8" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#EAF3FF" />
    <SolidColorBrush x:Key="MenuItemPressedBrush" Color="#E2EEFC" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#0B1B45" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#E3EBF7" />
    <SolidColorBrush x:Key="MenuSubtleBrush" Color="#7A8FC0" />
    <SolidColorBrush x:Key="MenuDisabledBrush" Color="#A0AFC8" />

</ResourceDictionary>
